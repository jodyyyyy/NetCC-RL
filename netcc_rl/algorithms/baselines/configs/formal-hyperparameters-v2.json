{
  "schema_version": 2,
  "algorithms": {
    "happo": {
      "formal_runtime": {
        "gamma": 0.99,
        "gae_lambda": 1.0,
        "batch_episode": 10,
        "kl_coeff": 0.2,
        "kl_target": 0.01,
        "num_sgd_iter": 5,
        "grad_clip": 10.0,
        "clip_param": 0.3,
        "critic_lr": 0.0005,
        "actor_lr": 5e-07,
        "vf_loss_coeff": 1.0,
        "gain": 0.01,
        "entropy_coeff": 0.01,
        "vf_clip_param": 10.0,
        "batch_mode": "truncate_episodes",
        "min_lr_schedule": 1e-11,
        "lr_schedule_steps": 1000000,
        "hidden": [
          256,
          256
        ],
        "activation": "tanh",
        "opp_action_in_cc": false,
        "radius_pi": 1,
        "rollout_steps": 150,
        "sgd_minibatch_size": 1500,
        "owner_passes": "num_agents",
        "normalize_advantages": true,
        "optimization_protocol": "fixed_budget_monitor_only",
        "optimizer_early_stopping": false
      },
      "smoke_only_overrides": {
        "batch_episode": 1,
        "sgd_minibatch_size": 150,
        "owner_passes": 1
      }
    }
  }
}
